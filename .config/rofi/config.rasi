configuration {
  display-drun: "Launch:";
  display-run: "Run:";
  display-window: "Windows:";
  drun-display-format: "{icon} {name}";
  font: "JetBrainMono NF Medium 12";
  modi: "window,run,drun";
  show-icons: true;
}

@theme "simple-tokyonight.rasi"

